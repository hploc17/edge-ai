# Explicit source of ANALYTICS. video = CSI direct; csi = existing pipeline frame.
ANALYTICS_SOURCE=video
BACKEND_URL=http://192.168.1.100:3000
EDGE_TOKEN=REPLACE_WITH_BACKEND_EDGE_TOKEN
EDGE_ID=edge-01
CAMERA_ID=camera-01
SEGMENT_ID=segment-001

# Only used by the standalone video agent. Embedded mode reuses main's MQTT.
MQTT_URL=mqtts://YOUR_CLUSTER.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=YOUR_USERNAME
MQTT_PASSWORD=YOUR_PASSWORD
# Different from main's MQTT_CLIENT_ID. Never use # as a publish/command topic.
MQTT_SNAPSHOT_CLIENT_ID=edge-01-snapshot-v2
MQTT_COMMAND_TOPIC=traffic/edge-01/command
MQTT_COMMAND_RESULT_TOPIC=traffic/edge-01/command-result
MQTT_TELEMETRY_TOPIC=traffic/edge-01/telemetry

CSI_SENSOR_ID=0
CSI_WIDTH=1920
CSI_HEIGHT=1080
CSI_FPS=30
CSI_CAPTURE_TIMEOUT_SECONDS=12
CONGESTION_CONFIRM_SECONDS=15
SNAPSHOT_COOLDOWN_SECONDS=60
TELEMETRY_STALE_SECONDS=5
JPEG_QUALITY=75
SNAPSHOT_QUEUE_SIZE=2
SNAPSHOT_FRAME_WAIT_SECONDS=12
SNAPSHOT_UPLOAD_TIMEOUT_SECONDS=15
SNAPSHOT_RETRY_SECONDS=15
SNAPSHOT_MAX_JPEG_BYTES=2097152
SNAPSHOT_OUTBOX_DIR=./snapshot_outbox_v2
SNAPSHOT_OUTBOX_MAX_ITEMS=500
SNAPSHOT_OUTBOX_MAX_BYTES=2147483648
