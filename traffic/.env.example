# ==============================================================================
# HỆ THỐNG CẤU HÌNH ĐỒNG BỘ EDGE TRAFFIC AI (NVIDIA JETSON NANO) - EXAMPLE
# Sao chép tệp này thành .env để sử dụng: cp .env.example .env
# ==============================================================================

# ── 1. Backend WebGIS & API Token ─────────────────────────────────────────────
BACKEND_URL=http://192.168.1.14:8000
EDGE_TOKEN=dev-edge-token

# ── 2. Định danh Thiết bị Phần cứng (Edge Node) ──────────────────────────────
# Các thông tin: Tên trạm, Tuyến đường, Tọa độ bản đồ (Lat/Lng), Góc quay Camera
# được thiết lập trực tiếp từ giao diện WebGIS khi thiết bị kết nối lần đầu,
# hoặc có thể chỉnh sửa lại bất cứ lúc nào qua nút "Sửa cấu hình" trên Web.
EDGE_ID=edge-01
CAMERA_ID=camera-01
SEGMENT_ID=segment-001
SENSOR_ID=0

# ── 3. HiveMQ Cloud MQTT Broker (TLS 8883) ────────────────────────────────────
MQTT_HOST=829e7cb26c594257a7470e5a5af58064.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=admin
MQTT_PASS=12345678
MQTT_AGENT_CLIENT_ID=edge-01-agent
MQTT_PIPELINE_CLIENT_ID=edge-01-pipeline

# ── 4. Nguồn Video & Cấu hình Pipeline DeepStream ──────────────────────────────
# VIDEO_SOURCE có thể là: 'csi' (camera CSI), đường dẫn file 'Video/test.mp4', hoặc 'rtsp://...'
VIDEO_SOURCE=csi
# Cấu hình xoay camera CSI: 0=Bình thường, 2=Xoay 180 độ (lật ngược lại nếu camera bị ngược), 4=Lật ngang, 6=Lật dọc
CSI_FLIP_METHOD=2
ACTIVE_VEHICLE_CLASSES=motorbike,car,truck,bus,bicycle
ROI_CONFIG=configs/roi_traffic_nano.json
INFER_CONFIG=configs/config_infer_yolo11_nano.txt
TRACKER_CONFIG=configs/config_tracker_optimized.yml
LABELS_FILE=configs/labels_custom.txt
SOURCE_FPS=30.0

# ── 5. Ngưỡng Phân tích Giao thông & Ước tính Vận tốc ───────────────────────────
STOPPED_SPEED_KMH=5.0
CONGESTED_SPEED_KMH=15.0
SLOW_SPEED_KMH=30.0
SLOW_DENSITY=80.0
CONGESTED_DENSITY=120.0

# ── 6. Dịch vụ Chụp ảnh Snapshot Bằng chứng (Outbox & HTTP) ────────────────────
ENABLE_SNAPSHOT=true
CONGESTION_CONFIRM_SECONDS=15.0
SNAPSHOT_COOLDOWN_SECONDS=60.0
JPEG_QUALITY=75
OUTBOX_DIR=/app/outbox
SNAPSHOT_QUEUE_SIZE=2
SNAPSHOT_UPLOAD_TIMEOUT_SECONDS=15
