# Environment & Secrets (TUYỆT ĐỐI KHÔNG ĐƯA LÊN GITHUB)
.env
snap/.env
traffic/.env
webgis/backend/.env
*.token
*.pem
*.key

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.log
*.sqlite3
*.db
*.lock

# TensorRT Engines & Heavy Models (Build tại chỗ trên Jetson)
*.engine
*.onnx
*.weights

# Video files (nặng, không đưa lên git)
*.mp4
*.h264
*.mkv
*.avi
*.filepart
Video/*
!Video/.gitkeep
traffic/Video/*
!traffic/Video/.gitkeep
traffic_backup/

# Cache, Local Outbox & Snapshots
outbox/
snap/outbox/
snap/snapshots/
snapshot_outbox*/
traffic/snapshot_outbox*/
webgis/backend/data/snapshots/*.jpg
webgis/backend/data/snapshots/*.jpeg
webgis/backend/data/snapshots/*.png
!webgis/backend/data/snapshots/.gitkeep

# Node.js & Frontend dependencies
node_modules/
webgis/frontend/node_modules/
webgis/frontend/dist/
webgis/frontend/.vite/

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
