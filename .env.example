# ==============================================================
# HỆ THỐNG EDGE AI TRAFFIC - JETSON NANO (MẪU CẤU HÌNH .env)
# ==============================================================

# Backend REST API (Port 8000 của FastAPI)
BACKEND_URL=http://192.168.1.26:8000
EDGE_TOKEN=dev-edge-token

# Định danh thiết bị & WebGIS Node
EDGE_ID=edge-01
DEVICE_NAME=Nút giao Nguyễn Trãi - Khuất Duy Tiến
NODE_NAME=Camera AI Jetson (edge-01)
CAMERA_ID=camera-01
SEGMENT_ID=segment-001
ROAD_NAME=Nguyễn Trãi
SENSOR_ID=0
CSI_SENSOR_ID=0

# Tọa độ WGS84 & Góc nhìn Camera cho WebGIS
GEO_LAT=20.998412
GEO_LNG=105.795123
NODE_LAT=20.998412
NODE_LON=105.795123
GEO_ALTITUDE_M=12.5
CAMERA_HEADING=45.0
CAMERA_FOV=65.0

# HiveMQ Cloud MQTT Broker
MQTT_HOST=829e7cb26c594257a7470e5a5af58064.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=admin
MQTT_PASS=12345678

# Tách biệt MQTT Client ID để tránh đá nhau (rc=7)
MQTT_AGENT_CLIENT_ID=edge-01-agent
MQTT_PIPELINE_CLIENT_ID=edge-01-pipeline
MQTT_SNAPSHOT_CLIENT_ID=edge-01-snapshot

# Cấu hình chụp ảnh Snapshot & Ngưỡng chống spam
CONGESTION_CONFIRM_SECONDS=15.0
SNAPSHOT_COOLDOWN_SECONDS=60.0
JPEG_QUALITY=75
SNAPSHOT_QUEUE_SIZE=2
SNAPSHOT_UPLOAD_TIMEOUT_SECONDS=15
SNAPSHOT_RETRY_SECONDS=15
OUTBOX_DIR=outbox
SNAPSHOT_OUTBOX_DIR=./outbox

# Cấu hình nguồn video phân tích (file hoặc csi)
ANALYTICS_SOURCE=file

# ==============================================================
# CẤU HÌNH THUẬT TOÁN ĐÁNH GIÁ ÙN TẮC (V1 vs V2)
# ==============================================================
# TRAFFIC_ALGORITHM_VERSION:
#   - v1: Phương án 1 (Spatial Snapshot - Trọng số 50-30-20 cơ bản)
#   - v2: Phương án 2 (Context-Aware Dwell-Time - Ân hạn đèn đỏ 30s & Low Count Guard)
TRAFFIC_ALGORITHM_VERSION=v1

# ==============================================================
# CẤU HÌNH ON-DEMAND LIVE STREAMING (MediaMTX + GStreamer NVENC)
# ==============================================================
LIVE_STREAM_ENABLED=1
LIVE_WIDTH=640
LIVE_HEIGHT=360
LIVE_FPS=15
LIVE_BITRATE=1500000
LIVE_IDLE_TIMEOUT_S=60

# MediaMTX Server Config
MEDIAMTX_HOST=localhost
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WEBRTC_PORT=8889
# LIVE_RTSP_URL=rtsp://localhost:8554/live/edge-01


