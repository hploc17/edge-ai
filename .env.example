# Backend API & Token
BACKEND_URL=http://192.168.1.26:3000
EDGE_TOKEN=dev-edge-token

# Dinh danh thiet bi & Thong tin WebGIS
EDGE_ID=edge-01
DEVICE_NAME=Nút giao Nguyễn Trãi - Khuất Duy Tiến
CAMERA_ID=camera-01
SEGMENT_ID=segment-001
ROAD_NAME=Nguyễn Trãi
SENSOR_ID=0

# Toa do Dia khong gian (WGS84) & Huong Camera cho WebGIS
GEO_LAT=20.998412
GEO_LNG=105.795123
GEO_ALTITUDE_M=12.5
CAMERA_HEADING=45.0
CAMERA_FOV=65.0

# HiveMQ Cloud MQTT Broker
MQTT_HOST=829e7cb26c594257a7470e5a5af58064.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=admin
MQTT_PASS=12345678

# Nguong kich hoat Snapshot (giay)
CONGESTION_CONFIRM_SECONDS=15.0
SNAPSHOT_COOLDOWN_SECONDS=60.0
JPEG_QUALITY=75

# Thu muc luu dem ngoai tuyen
OUTBOX_DIR=/app/outbox
